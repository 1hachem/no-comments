{
	"name": "no-comments",
	"version": "1.1.0",
	"description": "Fail CI on comments in TypeScript, TSX, Astro and CSS.",
	"type": "module",
	"bin": {
		"no-comments": "dist/no-comments.cjs"
	},
	"files": [
		"dist",
		"action.yml",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "esbuild src/no-comments.ts --bundle --platform=node --format=cjs --target=node20 --banner:js='#!/usr/bin/env node' --outfile=dist/no-comments.cjs",
		"test": "NO_COMMENTS_LIB=1 node --test test/*.test.ts",
		"check": "node dist/no-comments.cjs"
	},
	"devDependencies": {
		"esbuild": "^0.25.0",
		"typescript": "^5.9.3"
	}
}
